{% extends 'base.html.twig' %}

{% block title %}SubCategory index{% endblock %}

{% block body %}
    <div class="container"><br><br>
        <h1>Sous Categories</h1>
        <a class="btn btn-primary" href="{{ path('app_sub_category_new') }}">Creer Une Sous Categorie</a>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Categorie</th>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for sub_category in sub_categories %}
                <tr>
                    <td>{{ sub_category.id }}</td>
                    <td>{{ sub_category.nom }}</td>
                    <td>{{sub_category.category.nom}}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path('app_sub_category_show', {'id': sub_category.id}) }}">Voir</a>
                        <a class="btn btn-danger" href="{{ path('app_sub_category_edit', {'id': sub_category.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

       
    </div>
{% endblock %}
