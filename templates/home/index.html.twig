{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
    <div class="container">
    <h1>Produits</h1>
    <div class="row">
        {% for product in products %}
        <div class="col-md-3 d-flex align-items-stretch"> 
            <div class="card h-100 d-flex flex-column">
                <img src="{{ asset('uploads/images/' ~ product.image) }}" class="card-img-top" alt="...">
                <div class="card-body d-flex flex-column">
                 <a style="text-decoration:none" href="{{path('app_home_product_show',{'id':product.id})}}"><h5 class="card-title">{{ product.nom }}</h5></a>   
                    <p class="card-text">{{ product.description | slice(0,50) }}...</p>
                    <a href="#" class="btn btn-outline-success mt-auto">Ajouter au panier</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
