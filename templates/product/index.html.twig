{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <div class="container">
        <h1>Produits</h1><br><br>
        {% include "layouts/_flash_message.html.twig" %}
        <a class="btn btn-primary" href="{{ path('app_product_new') }}">Créer Un Produit</a><br><br>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>Stock>
                    <th>actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.id }}</td>
                    <td>{{ product.nom }}</td>
                    <td>{{ product.description | slice(0,70)}}...</td>
                    <td>{{ product.prix }}€</td>
                    <td>
                        {% if product.stock > 0 %}
                            {{product.stock}}
                            {% else %}
                                <span class="text-bg-danger">Stock épuisé</span>
                        {% endif %}
                        
                    </td>
                    <td>
                        <a class="btn btn-outline-primary" href="{{ path('app_product_show', {'id': product.id}) }}">Voir</a>
                        <a class="btn btn-outline-success" href="{{ path('app_product_edit', {'id': product.id}) }}">Modifier</a>
                        <a class="btn btn-outline-info" href="{{ path('app_product_stock_add', {'id': product.id}) }}">Ajouter Le stock</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

      
    </div>
{% endblock %}
