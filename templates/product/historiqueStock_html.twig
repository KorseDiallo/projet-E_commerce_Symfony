{% extends "base.html.twig" %}


{% block body %}
    <div class="container">
        <table class="table">
            <tr>
                <th>id</th>
                <th>quantité</th>
                <th>date d'ajout</th>
            </tr>
            {% for productAddedHistory in productsAddedHistory %}
                <tr>
                    <td>{{productAddedHistory.id}}</td>
                    <td>{{productAddedHistory.quantite}}</td>
                    <td>{{productAddedHistory.createdAt | date }}</td>
                </tr>
            {% endfor %}
        </table>
    </div>
{% endblock %}